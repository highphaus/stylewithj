# ==============================================================================
# HighP Enterprise Activity & Attendance SaaS - Environment Template
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Application Branding & Client URLs
APP_NAME="HighP Workforce Telemetry & Attendance"
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000

# Database Connectivity (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://shamsaifudheen_db_user:Stm6NhQ2yWcVdNwG@agent.epapfo7.mongodb.net/highphaus?retryWrites=true&w=majority

# Security & JWT Tokens (256-bit secure strings)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=30d

# Cross-Origin Resource Sharing (CORS) Whitelist
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000

# Telemetry Cadence & Activity Thresholds
DEFAULT_IDLE_THRESHOLD_MINUTES=5
DEFAULT_HEARTBEAT_INTERVAL_SECONDS=30

# Frontend Environment Variables (Vite & Next.js)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_DESKTOP_AGENT_URL=https://github.com/MuhammedSyamS/HighP-desktop-agent/releases/latest
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Optional Redis Pub/Sub for Multi-Server Horizontal Scaling
# REDIS_URL=redis://default:password@localhost:6379
